# Required. Claude drafts, decomposes, and verifies claims.
ANTHROPIC_API_KEY=

# Optional. Raises the PubMed E-utilities rate limit from 3 to 10 requests per second.
PUBMED_API_KEY=

# Optional. Parallel.ai web search for guidelines and recent sources.
PARALLEL_API_KEY=

# Optional. Only needed for POST /baseline (the unaided-model comparison).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Optional. When set, eval.braintrust_probes logs experiments to Braintrust.
BRAINTRUST_API_KEY=
